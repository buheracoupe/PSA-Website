# LOCAL DEVELOPMENT. Copy this to .env. Never commit real credentials.
APP_MODE=demo
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
# Empty uses durable PGlite in ./data/database. Separate worker requires PostgreSQL.
DATABASE_URL=
DATA_DIR=./data
COMPANY_EMAIL_DOMAIN=pumpsystemsafrica.com
# Live mode requires PostgreSQL, HTTPS APP_ORIGIN, SMTP and pre-provisioned staff.
EMAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Deliberately unconfigured until authenticated source access is implemented.
PRAZ_MODE=unconfigured
PRIVATE_MODE=unconfigured
# In demo mode only, set both above to fixture to demonstrate ingestion.
AI_MODE=unconfigured
WORKER_INTERVAL_MS=30000
