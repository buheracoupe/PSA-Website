{
  "name": "pump-systems-tender-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "worker": "node --env-file-if-exists=.env src/worker.mjs",
    "migrate": "node --env-file-if-exists=.env src/manage.mjs migrate",
    "seed": "node --env-file-if-exists=.env src/manage.mjs seed",
    "staff": "node --env-file-if-exists=.env src/manage.mjs staff",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": { "@electric-sql/pglite": "0.3.14", "pg": "8.16.3", "nodemailer": "7.0.11" }
}
